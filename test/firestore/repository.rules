rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Local repository tests have no authentication emulator. Production uses
    // the root firestore.rules. This file is loaded by firebase.repository.json
    // when running the local demo project.
    match /{document=**} {
      allow read, write: if database == '(default)'
          && request.auth == null;
    }
  }
}
