{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build iOS Simulator",
      "type": "process",
      "command": "flutter",
      "args": ["build", "ios", "--simulator", "--debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
