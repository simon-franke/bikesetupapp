{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iPhone 12 Pro (Release)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "00008101-00023D1C34C1001E",
      "flutterMode": "release",
      "cwd": "${workspaceFolder}/app"
    },
    {
      "name": "Attach to running Flutter app",
      "type": "dart",
      "request": "attach",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "${input:flutterDeviceId}",
      "vmServiceUri": "${input:flutterVmServiceUri}",
      "cwd": "${workspaceFolder}/app"
    }
  ],
  "inputs": [
    {
      "id": "flutterDeviceId",
      "type": "promptString",
      "description": "Device ID from flutter devices"
    },
    {
      "id": "flutterVmServiceUri",
      "type": "promptString",
      "description": "Dart VM service URL printed by the running app"
    }
  ]
}
