rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {

      function canWrite(userID) {
        return request.auth != null && request.auth.uid == userID
          && !exists(/databases/$(database)/documents/AccountDeletions/$(userID));
      }

      // All app data lives under UserBikeSetup/{userID}
      // Only the authenticated user may read/write their own document tree
      match /UserBikeSetup/{userID} {
        allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);

        match /Bikes/{bikeID} {
          allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);

          match /SetupList/{setupID} {
            allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
            match /Tests/{testID} {
              allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
            }
          }

          // Per-setup category subcollections (Fork, Shock, RearTire, FrontTire, GeneralSettings)
          match /{setupID}/{category} {
            allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
          }
        }

        match /ToDoList/{bikeID}/MyList/{docID} {
          allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
        }

        match /RideLog/{rideID} {
          allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
        }

        match /StravaBikes/{gearId} {
          allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
        }

        match /ServiceComponents/{componentId} {
          allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);

          match /ServiceEntries/{entryId} {
            allow read: if request.auth != null && request.auth.uid == userID;
        allow write: if canWrite(userID);
          }
        }
      }

      // Deny everything else
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
